{
  "name": "sleipnir",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src",
  "targets": {
    "build": {
      "command": "npm run build"
    },
    "dev": {
      "command": "vite"
    },
    "start": {
      "command": "vite"
    },
    "serve": {
      "command": "vite"
    },
    "preview": {
      "command": "vite preview"
    },
    "test": {
      "command": "vitest run"
    },
    "test:watch": {
      "command": "vitest"
    },
    "lint": {
      "command": "eslint ."
    },
    "storybook": {
      "command": "storybook dev -p 6006"
    },
    "build-storybook": {
      "command": "storybook build"
    }
  }
}
