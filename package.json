{
  "name": "sleipnir",
  "private": true,
  "version": "0.0.2",
  "description": "A tactical desktop workbench for research-driven UI design with a built-in AI coding agent.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Andrew Sterns",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrewsterns/Sleipnir.git"
  },
  "homepage": "https://github.com/andrewsterns/Sleipnir",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "start:nx": "nx serve sleipnir",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:nx": "docker exec -it sleipnir_web nx",
    "docker:test": "docker exec -it sleipnir_web npm test",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "preview": "vite preview",
    "generate:graph": "node tools/generate-graph.mjs",
    "electron:dev": "concurrently -k \"npm:dev\" \"wait-on http://localhost:5183 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:publish": "npm run build && electron-builder --publish always",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "d3-force-3d": "^3.0.6",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.169.0",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@nx/devkit": "^22.6.1",
    "@nx/eslint": "^22.6.1",
    "@nx/js": "^22.6.1",
    "@nx/react": "^22.6.1",
    "@nx/vite": "^22.6.1",
    "@nx/vitest": "^22.6.1",
    "@nx/web": "^22.6.1",
    "@nx/workspace": "^22.6.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "lint-staged": "^16.4.0",
    "nx": "22.7.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "to-ico": "^1.1.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "typescript-language-server": "^5.3.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8",
    "wait-on": "^9.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "nx": {},
  "build": {
    "appId": "com.sleipnir.app",
    "productName": "Sleipnir",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tools/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "andrewsterns",
        "repo": "Sleipnir"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sleipnir",
      "runAfterFinish": true,
      "license": "LICENSE"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
