      "language": "typescript"
    },
    {
      "id": "plan/lsp-typing-latency-1793049413729/drop-the-duplicate-hover-source-1793049428640",
      "label": "Drop the duplicate hover source",
      "kind": "proposed",
      "map": "claude",
      "type": "plan-step",
      "description": "Every LSP editor gets hoverTooltips() twice: once inside the client's languageServerExtensions() (LSPClient.plugin includes client extensions per editor) and again via lspHoverTooltips in CodeEditorView.ViewModel's lspExtension. Each hover sends two textDocument/hover requests and builds two tooltips. Keep the client's one, remove the extra.",
      "status": "draft",
      "planId": "plan/lsp-typing-latency-1793049413729",
      "order": 2,
      "editsPaths": [
        "src/app/DesignSystem/lspClient.ts",
        "src/app/DesignSystem/CodeEditorView.ViewModel.tsx"
      ]
    },
    {
      "id": "plan/lsp-typing-latency-1793049413729/dedupe-ctrl-hover-definition-lookups-1793049428763",
      "label": "Dedupe Ctrl-hover definition lookups",
      "kind": "proposed",
      "map": "claude",
      "type": "plan-step",
      "description": "modHoverDefinitionLink sends sync() + textDocument/definition on every mousemove while Ctrl is held, even over the same word. Cache the last word range per view and only ask again when the word under the pointer changes; keep the existing token guard for out-of-order responses.",
      "status": "draft",
      "planId": "plan/lsp-typing-latency-1793049413729",
      "order": 3,
      "editsPaths": [
        "src/app/DesignSystem/lspClient.ts"
      ]
    },
    {
      "id": "plan/lsp-typing-latency-1793049413729/trim-per-keystroke-editor-work-1793049428904",
      "label": "Trim per-keystroke editor work",
      "kind": "proposed",
      "map": "claude",
      "type": "plan-step",
      "description": "The editor's updateListener runs diagnosticCount() and a setProblemCount on every update, including cursor moves and focus changes. Recount only when the doc changed or a diagnostics transaction landed, so typing and arrowing don't touch React state they don't change.",
      "status": "draft",
      "planId": "plan/lsp-typing-latency-1793049413729",
      "order": 4,
      "editsPaths": [
        "src/app/DesignSystem/CodeEditorView.ViewModel.tsx"
      ]
    },
    {
      "id": "plan/lsp-typing-latency-1793049413729/route-tsserver-responses-per-connection-1793049429036",
      "label": "Route tsserver responses per connection",
      "kind": "proposed",
      "map": "claude",
      "type": "plan-step",
      "description": "The proxy binds every WebSocket connection's reader to the same tsserver stdout, so each connection receives every message: two windows' request ids collide, responses land in the wrong window, and the external server is killed when any one of its windows closes. Extract a router that rewrites request ids to be unique per server and maps responses back to their connection, broadcasts notifications, and ref-counts the external server. Also replace the per-chunk Buffer.concat deframer with a chunk list (minor at measured sizes, but quadratic on large messages).",
      "status": "draft",
      "planId": "plan/lsp-typing-latency-1793049413729",
      "order": 5,
      "editsPaths": [
        "tools/lsp-proxy.mjs"
      ]
    },
