    {
      "id": "plan/lsp-typing-latency-1793049413729/instrument-lsp-round-trips-1793049428561",
      "label": "Instrument LSP round-trips",
      "kind": "proposed",
      "map": "claude",
      "type": "plan-step",
      "description": "Wrap the WebSocket transport so every request is timed by method, with response size, and slow ones (over 50ms, or over 64KB) are logged in dev. Gives a before/after number for every later step instead of guessing. Measured outside the app already: identifier completions in this repo are ~1,000 items / 74 KB / 14-68 ms and complete (cached by the editor), import-path completions 15 items / 3 ms — so payload size is not the bottleneck and is not a step.",
      "status": "draft",
      "planId": "plan/lsp-typing-latency-1793049413729",
      "order": 1,
      "editsPaths": [
        "src/app/DesignSystem/lspClient.ts"
      ]
    },
